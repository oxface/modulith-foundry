{
  "realm": "modulith-foundry",
  "displayName": "Modulith Foundry",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "modulith-foundry-bff",
      "name": "Modulith Foundry BFF",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MODULITH_FOUNDRY_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "webOrigins": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:*##https://localhost:*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "${MODULITH_FOUNDRY_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
